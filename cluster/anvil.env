# Purdue Anvil: environment and Slurm defaults for appSpector's setup.sh.
# Requires ALLOC (the Slurm account, e.g. asc050025). Key-authenticated ssh,
# no control master needed. The default work directory follows the
# allocation's convention, /anvil/projects/x-<account>/<user>/software/...;
# that project space has a shared 1M-file quota and a Charm++ tree is a few
# hundred thousand files, so check `myquota` first, or use scratch
# (APPSPECTOR_WORK=/anvil/scratch/$USER/appspector; purged periodically).
SITE_SSH=anvil
WORK_DEFAULT=/anvil/projects/x-$ALLOC/$USER/software/appspector
ACCOUNT_DEFAULT=$ALLOC
PARTITION_DEFAULT=shared
CORES_PER_NODE=128
LAUNCHER='srun --mpi=pmi2 -n {procs} -c {cores_per_proc}'
MEM_DEFAULT=
site_env() {
  cat <<'EOS'
[ -z "${LMOD_CMD:-}" ] && source /etc/profile.d/modules.sh 2>/dev/null
module load python/3.9.5
module load libfabric/1.12.0
module load hwloc
export HWLOC_ROOT=${RCAC_HWLOC_ROOT:-}
EOS
}
