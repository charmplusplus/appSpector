# NCSA Delta: environment and Slurm defaults for appSpector's setup.sh.
# Requires ALLOC (the X in X-delta-cpu). Login needs Duo; the laptop uses an
# ssh control master (see docs/MANUAL.md, "Reaching a cluster").
# JPEG liveViz images (viewer --jpeg): Delta has only the runtime
# /usr/lib64/libjpeg.so.62, no headers and no module, so Charm++'s
# configure (find_package(JPEG)) would find no libjpeg. site_env points
# the build at Spack's libjpeg-turbo (headers and libjpeg.so, soname .62
# like the system one), which gives CMK_USE_LIBJPEG 1 and links the
# programs with -ljpeg; verified end to end with pfield and --jpeg. A
# Charm++ built before this has no JPEG: rebuild it (remove the build
# directory and run setup.sh again).
SITE_SSH=delta
WORK_DEFAULT=/work/hdd/$ALLOC/$USER/appspector
ACCOUNT_DEFAULT=$ALLOC-delta-cpu
PARTITION_DEFAULT=cpu-interactive
CORES_PER_NODE=128
LAUNCHER='stdbuf -o0 -e0 srun --mpi=pmix -n {procs} -c {cores_per_proc}'
MEM_DEFAULT=16g
site_env() {
  cat <<'EOS'
[ -z "${LMOD_CMD:-}" ] && source /usr/share/lmod/lmod/init/bash
module load cmake/3.31.8
export FI_PROVIDER=cxi
export LCI_NETWORK_BACKENDS=ofi
JPEG_ROOT=/sw/spack/delta-2022-03/apps/libjpeg-turbo/3.0.0-gcc-11.2.0-b2bozql
if [ -d "$JPEG_ROOT" ]; then
  export CMAKE_PREFIX_PATH=$JPEG_ROOT${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}
  export CPATH=$JPEG_ROOT/include${CPATH:+:$CPATH}
  export LIBRARY_PATH=$JPEG_ROOT/lib64${LIBRARY_PATH:+:$LIBRARY_PATH}
fi
EOS
}
